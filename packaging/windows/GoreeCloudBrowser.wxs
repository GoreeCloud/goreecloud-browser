<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="GoreeCloud Browser"
    Manufacturer="GoreeCloud"
    Version="0.1.0"
    UpgradeCode="8E4E03D1-9EE2-4EFA-8B10-D773586A8B72">
    <MajorUpgrade DowngradeErrorMessage="A newer version of GoreeCloud Browser is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="GoreeCloud Browser">
        <Component Id="BrowserExecutable" Guid="*">
          <File Id="GoreeCloudBrowserExe" Source="$(var.BrowserExe)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="GoreeCloud Browser" Level="1">
      <ComponentRef Id="BrowserExecutable" />
    </Feature>
  </Package>
</Wix>

<!--
Development scaffold only. Production Windows packaging still requires:
- signed executable and installer;
- Tabmark icon resources;
- Start Menu/application registration;
- HTTP/HTTPS/default-browser registration using supported Windows mechanisms;
- uninstall/repair/upgrade validation;
- Chromium runtime payload and sandbox validation;
- exact-source release evidence.
-->
